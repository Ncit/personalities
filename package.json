{
  "name": "mbti-personality-quiz",
  "version": "2.0.0",
  "description": "A comprehensive MBTI personality assessment platform with multiple specialized quizzes",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.{js,css,html}",
    "analyze": "npm run build && npx vite-bundle-analyzer dist"
  },
  "keywords": [
    "mbti",
    "personality",
    "quiz",
    "assessment",
    "psychology",
    "typescript",
    "vite"
  ],
  "author": "MBTI Quiz Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-legacy": "^7.0.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^2.8.8",
    "typescript": "^5.1.6",
    "vite": "^7.0.5",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "dependencies": {
    "eruda": "^3.4.3",
    "firebase": "^12.0.0",
    "jspdf": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
