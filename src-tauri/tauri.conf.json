{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonaDev",
  "version": "1.2.0",
  "identifier": "ru.nikmobdev.personadev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001"
  },
  "app": {
    "windows": [
      {
        "title": "PersonaDev",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
